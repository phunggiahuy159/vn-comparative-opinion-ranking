% Shared look for Group 20's IT4868E reports (progress + final). XeLaTeX (tectonic).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{g20style}[2026/11/23 Group 20 report style]

%---------------------------------------------------------------- fonts
\RequirePackage{fontspec}
\setmainfont{texgyretermes}[Extension=.otf, UprightFont=*-regular, BoldFont=*-bold,
  ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
\setsansfont{texgyreheros}[Extension=.otf, UprightFont=*-regular, BoldFont=*-bold,
  ItalicFont=*-italic, BoldItalicFont=*-bolditalic, Scale=0.92]
\RequirePackage{amsmath,amssymb}
\RequirePackage{unicode-math}
\setmathfont{texgyretermes-math.otf}
\RequirePackage{microtype}

%---------------------------------------------------------------- packages
\RequirePackage{booktabs,tabularx,multirow,array}
\RequirePackage[table]{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,fit}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage[most]{tcolorbox}
\RequirePackage{caption}
\RequirePackage{hyperref}

%---------------------------------------------------------------- palette (matches the figures)
\definecolor{accent}{HTML}{1F5FA8}      % EDR blue, darkened for text
\definecolor{accentsoft}{HTML}{EEF3FA}
\definecolor{ink2}{HTML}{5A5E66}        % secondary text
\definecolor{rulegray}{HTML}{C9CDD3}
\definecolor{okc}{HTML}{1B7F55}
\definecolor{runc}{HTML}{B36B00}
\definecolor{planc}{HTML}{6B6F76}
\hypersetup{colorlinks=true, linkcolor=accent, citecolor=accent, urlcolor=accent}

%---------------------------------------------------------------- headings
\titleformat{\section}{\sffamily\large\bfseries\color{accent}}{\thesection}{0.6em}{}
\titlespacing*{\section}{0pt}{9pt}{3pt}
\titleformat{\subsection}{\sffamily\normalsize\bfseries}{\thesubsection}{0.5em}{}
\titlespacing*{\subsection}{0pt}{6pt}{2pt}
\newcommand{\lead}[1]{{\sffamily\bfseries\color{accent}#1}\enspace}   % paragraph lead-in

%---------------------------------------------------------------- body
\setlength{\parskip}{2.5pt}
\setlength{\parindent}{0pt}
\setlist{nosep,leftmargin=1.3em}
\setlist[itemize]{label={\color{accent}\textbullet}}
\captionsetup{font=small,labelfont={sf,bf,color=accent},skip=3pt}
\renewcommand{\arraystretch}{1.12}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcommand{\best}[1]{\textbf{#1}}
\newcommand{\rowhl}{\rowcolor{accentsoft}}                           % highlight our method's row

%---------------------------------------------------------------- header / footer
\newcommand{\g@doctype}{Report}
\newcommand{\doctype}[1]{\renewcommand{\g@doctype}{#1}}
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[L]{\sffamily\scriptsize\color{ink2}IT4868E Web Mining \,\textbullet\, Group 20}
\fancyhead[R]{\sffamily\scriptsize\color{ink2}\g@doctype}
\fancyfoot[C]{\sffamily\scriptsize\color{ink2}\thepage\ / \pageref*{LastPage}}
\fancypagestyle{first}{\fancyhf{}\fancyfoot[C]{\sffamily\scriptsize\color{ink2}\thepage\ / \pageref*{LastPage}}}

%---------------------------------------------------------------- status badges
\newcommand{\badge}[2]{\tcbox[on line, colback=#1!13, colframe=#1!13, coltext=#1!85!black, boxrule=0pt,
  boxsep=0pt, left=3pt, right=3pt, top=1.2pt, bottom=1.2pt, arc=2pt, fontupper=\sffamily\scriptsize\bfseries]{#2}}
\newcommand{\done}{\badge{okc}{done}}
\newcommand{\running}{\badge{runc}{running}}
\newcommand{\queued}{\badge{runc}{queued}}
\newcommand{\requested}{\badge{runc}{requested}}
\newcommand{\planned}{\badge{planc}{planned}}

%---------------------------------------------------------------- boxes
\newtcolorbox{keybox}[1][]{enhanced, breakable, colback=accentsoft, colframe=accent, boxrule=0pt,
  leftrule=2.5pt, arc=0pt, outer arc=0pt, left=7pt, right=7pt, top=4pt, bottom=4pt,
  before skip=5pt, after skip=5pt, fontupper=\small, #1}

%---------------------------------------------------------------- pipeline figure style
\tikzset{
  g20box/.style={draw=accent!55, rounded corners=2pt, align=center, minimum height=0.95cm,
    fill=accentsoft, font=\sffamily\scriptsize},
  g20ours/.style={g20box, draw=accent, fill=accent, text=white, font=\sffamily\scriptsize\bfseries},
  g20arr/.style={-{Stealth[length=4pt]}, thick, color=accent!70}}

